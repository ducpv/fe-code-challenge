{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "public",
    "rootDir": "client",
    "skipLibCheck": true,
    "types": []
  },
  "include": ["client/**/*.ts"]
}
